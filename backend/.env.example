DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cms_db?schema=public"

PORT=5000
NODE_ENV=development

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

UPLOAD_MAX_FILE_SIZE_MB=10

# Sends OTP/password-reset codes via Resend (https://resend.com). Leave RESEND_API_KEY unset for
# local dev — codes fall back to a console log instead of a real email. EMAIL_FROM must be an
# address on a domain you've verified in Resend (or the sandbox onboarding@resend.dev, which can
# only send to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM="CMS <onboarding@resend.dev>"
