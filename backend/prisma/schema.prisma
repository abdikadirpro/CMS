generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// ENUMS
// ==========================================================================

enum AdminType {
  SUPER_ADMIN
  ZONE_ADMIN
  TOWN_ADMIN
  DISTRICT_ADMIN
  OFFICE_ADMIN
}

enum PartyAdminType {
  PARTY_SUPER_ADMIN
  PARTY_ZONE_ADMIN
  PARTY_TOWN_ADMIN
  PARTY_DISTRICT_ADMIN
  PARTY_OFFICE_ADMIN
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  WAITING
  SOLVED
  TRANSFERRED
  REJECTED
  ESCALATED
}

enum RecipientType {
  USER
  ADMIN
}

enum NotificationType {
  COMPLAINT_CREATED
  STATUS_CHANGED
  COMPLAINT_ASSIGNED
  COMPLAINT_TRANSFERRED
  NOTE_ADDED
  SYSTEM
}

enum ActorType {
  USER
  ADMIN
  PARTY_ADMIN
  MEMBER
  SYSTEM
}

enum MemberStatus {
  PENDING
  PROBATIONARY
  FULL
  REJECTED
}

enum VolunteerStatus {
  NEW
  CONTACTED
  ACTIVE
  INACTIVE
}

enum DonationStatus {
  PENDING
  CONFIRMED
}

// ==========================================================================
// IDENTITY
// ==========================================================================

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String?
  idNumber     String?
  passwordHash String
  avatarUrl    String?
  isActive     Boolean  @default(true)

  isEmailVerified      Boolean   @default(false)
  otpCodeHash          String?
  otpExpiresAt         DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  complaints    Complaint[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Admin {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  adminType    AdminType
  isActive     Boolean   @default(true)

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  townAdministrationId String?
  townAdministration   TownAdministration? @relation(fields: [townAdministrationId], references: [id])

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedComplaints  Complaint[]         @relation("AssignedAdmin")
  createdComplaintNotes ComplaintNote[]
  transfersInitiated  ComplaintTransfer[] @relation("TransferInitiatedBy")
  transfersReceived   ComplaintTransfer[] @relation("TransferToAdmin")
  notifications       Notification[]
  refreshTokens       RefreshToken[]

  @@map("admins")
}

// Xisbiga Barwaaqo's own admin identity — fully separate from the complaint-system Admin table
// (own login/session), provisioned by the complaint-system SUPER_ADMIN. Mirrors Admin's own
// zone/district/town-administration/office jurisdiction scoping, but as an independent hierarchy.
model PartyAdmin {
  id             String         @id @default(uuid())
  fullName       String
  email          String         @unique
  phone          String?
  passwordHash   String
  avatarUrl      String?
  partyAdminType PartyAdminType
  isActive       Boolean        @default(true)

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  townAdministrationId String?
  townAdministration   TownAdministration? @relation(fields: [townAdministrationId], references: [id])

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens   RefreshToken[]
  reviewedMembers Member[]       @relation("MemberReviewedByPartyAdmin")

  @@map("party_admins")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  partyAdminId String?
  partyAdmin   PartyAdmin? @relation(fields: [partyAdminId], references: [id], onDelete: Cascade)
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ==========================================================================
// RBAC
// ==========================================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  admins      Admin[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================================================
// GEOGRAPHIC / ADMINISTRATIVE HIERARCHY
// ==========================================================================

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  admins      Admin[]
  partyAdmins PartyAdmin[]
  districts   District[]
  offices     Office[]
  complaints  Complaint[]
  members     Member[]
  volunteers  Volunteer[]
  donations   Donation[]

  @@map("zones")
}

model District {
  id     String @id @default(uuid())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  createdAt DateTime @default(now())

  admins      Admin[]
  partyAdmins PartyAdmin[]
  offices     Office[]
  complaints  Complaint[]
  members     Member[]
  volunteers  Volunteer[]
  donations   Donation[]

  @@unique([zoneId, name])
  @@map("districts")
}

model TownAdministration {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  admins      Admin[]
  partyAdmins PartyAdmin[]
  offices     Office[]
  complaints  Complaint[]
  members     Member[]
  volunteers  Volunteer[]
  donations   Donation[]

  @@map("town_administrations")
}

model Office {
  id     String @id @default(uuid())
  name   String
  createdAt DateTime @default(now())

  zoneId               String?
  zone                 Zone?               @relation(fields: [zoneId], references: [id])
  districtId           String?
  district             District?           @relation(fields: [districtId], references: [id])
  townAdministrationId String?
  townAdministration   TownAdministration? @relation(fields: [townAdministrationId], references: [id])

  admins      Admin[]
  partyAdmins PartyAdmin[]
  complaints  Complaint[]
  members     Member[]
  volunteers  Volunteer[]
  donations   Donation[]

  @@map("offices")
}

// ==========================================================================
// PARTY MEMBERSHIP (Xisbiga Barwaaqo)
// ==========================================================================

model PartyBranch {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members    Member[]
  volunteers Volunteer[]
  donations  Donation[]

  @@map("party_branches")
}

model Member {
  id               String       @id @default(uuid())
  membershipNumber String       @unique
  fullName         String
  phone            String
  // Nullable at the DB level (pre-existing rows may have none), but required by the registration
  // validator going forward — the shared login (partyAuth.controller.js) looks members up by
  // email alongside PartyAdmin, so it must stay unique.
  email            String?      @unique
  idNumber         String
  idDocumentPath   String?
  status           MemberStatus @default(PENDING)

  // Self-service login (membership number + password) — nullable because members registered
  // before this field existed have no password yet and need an admin-issued reset.
  passwordHash        String?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?

  // Set when a party admin approves the initial application (PENDING -> PROBATIONARY) — the
  // 6-month eligibility clock for full membership runs from here, not from registration.
  probationStartedAt DateTime?

  // Set when status first becomes FULL, one year out; renewed by extending it a further year.
  // A lapsed date means "Expired" in the UI — status stays FULL, membership isn't revoked.
  membershipExpiresAt DateTime?

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  townAdministrationId String?
  townAdministration   TownAdministration? @relation(fields: [townAdministrationId], references: [id])

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  partyBranchId String?
  partyBranch   PartyBranch? @relation(fields: [partyBranchId], references: [id])

  reviewedById    String?
  reviewedBy      PartyAdmin? @relation("MemberReviewedByPartyAdmin", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("members")
}

// A volunteer sign-up is intentionally lighter-weight than Member — no login, no probation
// workflow, just a lead for party admins to follow up on. Same jurisdiction hierarchy as Member
// so it can be scoped/managed the same way from the Barwaaqo portal.
model Volunteer {
  id       String          @id @default(uuid())
  fullName String
  phone    String
  email    String?
  interest String?
  status   VolunteerStatus @default(NEW)

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  townAdministrationId String?
  townAdministration   TownAdministration? @relation(fields: [townAdministrationId], references: [id])

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  partyBranchId String?
  partyBranch   PartyBranch? @relation(fields: [partyBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("volunteers")
}

// Placeholder/manual donation flow — no live payment gateway. A donor uploads proof of a
// transfer made outside the system (bank/mobile money), and a party admin confirms it, same
// pattern as the ID-document upload on member registration.
model Donation {
  id          String         @id @default(uuid())
  donorName   String
  phone       String
  email       String?
  amount      Decimal        @db.Decimal(12, 2)
  note        String?
  receiptPath String?
  status      DonationStatus @default(PENDING)

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  townAdministrationId String?
  townAdministration   TownAdministration? @relation(fields: [townAdministrationId], references: [id])

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  partyBranchId String?
  partyBranch   PartyBranch? @relation(fields: [partyBranchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("donations")
}

// ==========================================================================
// COMPLAINTS
// ==========================================================================

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  complaints Complaint[]

  @@map("categories")
}

model Complaint {
  id         String          @id @default(uuid())
  trackingId String          @unique
  title      String
  description String         @db.Text
  location    String?
  status      ComplaintStatus @default(PENDING)
  isAnonymous Boolean         @default(false)

  // guest / anonymous submitter fields (used when isAnonymous or no account)
  guestFullName   String?
  guestEmail      String?
  guestPhone      String?
  guestOffice     String?
  guestJobTitle   String?
  guestIdNumber   String?
  guestEmployeeId String?

  submitterId String?
  submitter   User?   @relation(fields: [submitterId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  townAdministrationId String?
  townAdministration   TownAdministration? @relation(fields: [townAdministrationId], references: [id])

  assignedAdminId String?
  assignedAdmin   Admin?  @relation("AssignedAdmin", fields: [assignedAdminId], references: [id])

  // Escalation tracking: currentLevelEnteredAt/lastFeedbackAt drive the citizen's 10-day
  // escalation window (see complaint.service.js getEscalationStatus), reset whenever the
  // complaint's handling level changes (creation, admin transfer, or citizen escalation).
  currentLevelEnteredAt DateTime   @default(now())
  lastFeedbackAt        DateTime?
  escalatedTo           AdminType?

  // Counts how many times the citizen has rejected a SOLVED resolution at the current handling
  // level (see complaint.service.js getEscalationStatus). Resets to 0 whenever the level changes.
  satisfactionRejections Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments    ComplaintAttachment[]
  notes          ComplaintNote[]
  statusHistory  ComplaintStatusHistory[]
  transfers      ComplaintTransfer[]

  @@map("complaints")
}

model ComplaintAttachment {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  mimeType    String
  fileSize    Int
  createdAt   DateTime @default(now())

  @@map("complaint_attachments")
}

model ComplaintNote {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id])
  content     String   @db.Text
  createdAt   DateTime @default(now())

  @@map("complaint_notes")
}

model ComplaintStatusHistory {
  id          String          @id @default(uuid())
  complaintId String
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  changedById String?
  changedByType ActorType     @default(ADMIN)
  reason      String?
  createdAt   DateTime        @default(now())

  @@map("complaint_status_history")
}

model ComplaintTransfer {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  fromAdminId String?
  fromAdmin   Admin?  @relation("TransferInitiatedBy", fields: [fromAdminId], references: [id])

  toAdminId String?
  toAdmin   Admin?  @relation("TransferToAdmin", fields: [toAdminId], references: [id])

  fromOfficeName String?
  toOfficeName   String?
  reason         String   @db.Text
  createdAt      DateTime @default(now())

  @@map("complaint_transfers")
}

// ==========================================================================
// NOTIFICATIONS & AUDIT
// ==========================================================================

model Notification {
  id            String            @id @default(uuid())
  recipientType RecipientType
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId       String?
  admin         Admin?            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  link          String?
  isRead        Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@map("notifications")
}

model ActivityLog {
  id          String    @id @default(uuid())
  actorId     String?
  actorType   ActorType
  actorName   String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@map("activity_logs")
}
