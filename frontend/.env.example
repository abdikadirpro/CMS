# In development, Vite proxies /api and /socket.io to the backend (see vite.config.js) —
# no environment variables are required to run `npm run dev` locally.
#
# In production (frontend and backend deployed to different domains/hosts), set this to the
# backend's public URL, no trailing slash. Used by baseApi.js, lib/socket.js, and attachment/
# backup download links.
# VITE_API_URL=https://api.example.com
